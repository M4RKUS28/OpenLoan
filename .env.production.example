# Production env for openloan.m4rkus28.de (behind CloudPanel, Docker nginx on :4568).
# Run prod with:  docker compose --env-file .env.production -f docker-compose.yml up -d --build
# NOTE: this file is gitignored — it holds secrets. Fill in every __CHANGE_ME__.

# ── Domain ───────────────────────────────────────────────────────────────────
DOMAIN=openloan.m4rkus28.de
AUTH_DOMAIN=auth.openloan.m4rkus28.de

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=__CHANGE_ME__

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ROOT_USER=__CHANGE_ME__
MINIO_ROOT_PASSWORD=__CHANGE_ME__
MINIO_BUCKET=uploads
MINIO_PRESIGNED_EXPIRY=3600
# Browser-reachable base for presigned URLs (nginx proxies /storage -> minio:9000)
MINIO_PUBLIC_URL=https://openloan.m4rkus28.de/storage

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_HOST=keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_DB=keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=__CHANGE_ME__
KEYCLOAK_REALM=app
KEYCLOAK_CLIENT_ID=app-frontend
KEYCLOAK_CLIENT_SECRET=__CHANGE_ME__

# ── Backend ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=__CHANGE_ME__
LOG_LEVEL=INFO
CORS_ORIGINS=["https://openloan.m4rkus28.de"]
